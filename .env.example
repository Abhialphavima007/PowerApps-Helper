# Copy this file to ".env" and fill in the keys you want to use.

# --- Optional AI provider keys (you can also save these in Settings) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_MODEL=
GEMINI_API_KEY=
GROK_API_KEY=

# Default provider when none is chosen in the UI: foundry | openai | claude | gemini | grok | template
AI_PROVIDER=gemini

# --- Microsoft sign-in (optional overrides) ---
# By default the app signs in using a Microsoft first-party PUBLIC client ID
# (the Azure CLI client), so NO app registration is required. Override only if
# your tenant blocks that client and you have your own public client ID.
# AZURE_CLIENT_ID=04b07795-8ddb-461a-bbee-02f9e1bf7b46
# AZURE_AUTHORITY=https://login.microsoftonline.com/common
# OneDrive/Graph uses a separate Graph-capable public client (Microsoft Graph CLI):
# AZURE_GRAPH_CLIENT_ID=14d82eec-204b-4c2f-b7e8-296a70dab67e
# Approved dependency repair uses the existing source Dataverse sign-in.
# No separate Dataverse MCP connection is required by the desktop.
