{
  "name": "powerapps-helper",
  "version": "0.1.2",
  "description": "Desktop app for Power Platform solution deployment, tracking, dependency review, git integration and AI-generated deployment notes.",
  "author": "Alphavima",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abhialphavima007/PowerApps-Helper.git"
  },
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c green,blue \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "start": "cross-env NODE_ENV=production electron .",
    "package": "npm run build:renderer && electron-builder",
    "package:win": "npm run build:renderer && electron-builder --win",
    "package:mac": "npm run build:renderer && electron-builder --mac",
    "package:linux": "npm run build:renderer && electron-builder --linux"
  },
  "dependencies": {
    "@azure/msal-node": "^2.13.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "adm-zip": "^0.5.16",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.alphavima.powerappshelper",
    "productName": "PowerApps Helper",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/scripts/*.ps1"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Abhialphavima007",
        "repo": "PowerApps-Helper",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
